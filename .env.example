# MedLens Environment Configuration
PORT=5001

# Optional: MongoDB Connection URI for persistent report storage
# If left empty, MedLens runs in Temporary Session Mode (In-Memory) with zero setup required.
MONGODB_URI=mongodb://localhost:27017/medlens

# Optional: Google Gemini API Key for LLM Explainable Summary & Interactive Chat
# If left empty, MedLens uses deterministic, grounded clinical explanation templates.
GEMINI_API_KEY=

# Optional: Configurable Gemini Model (defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

